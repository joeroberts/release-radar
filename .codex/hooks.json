{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/block_no_verify_commit.py\"",
            "timeout": 5,
            "statusMessage": "Checking Git commit options"
          }
        ]
      }
    ]
  }
}
